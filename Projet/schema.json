{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "nom", "numero", "aVendre", "prix", "notes", "favori", "dateAjout"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer" },
      "nom": { "type": "string", "minLength": 1 },
      "numero": { "type": "string" },
      "aVendre": { "type": "boolean" },
      "prix": { "type": "number", "minimum": 0 },
      "notes": { "type": "string" },
      "favori": { "type": "boolean" },
      "dateAjout": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    }
  }
}
